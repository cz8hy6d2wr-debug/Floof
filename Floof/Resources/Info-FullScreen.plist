<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Diese Schlüssel in die Info.plist des App-Targets übernehmen.
  Ohne UILaunchScreen läuft eine App auf unbekannten Displaygrößen im
  Kompatibilitätsmodus – das erzeugt die schwarzen Balken (Letterboxing).
-->
<plist version="1.0">
<dict>
    <!-- Native Auflösung auf jedem Display, kein Letterboxing -->
    <key>UILaunchScreen</key>
    <dict/>

    <!-- Größenänderung zulassen (Auf-/Zuklappen, Stage Manager) -->
    <key>UIRequiresFullScreen</key>
    <false/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>

    <!-- Alle Ausrichtungen: das 4:3-Innendisplay wird auch quer genutzt -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
